<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>UiLayoutProbe</AssemblyName>
    <!-- Manual development tool: renders both plugin windows to PNG so the layout can be checked
         without starting OpenUtau. Not part of the CI build. -->
    <OpenUtauCorePath Condition="'$(OpenUtauCorePath)' == '' and '$(OPENUTAU_CORE_PATH)' != ''">$(OPENUTAU_CORE_PATH)</OpenUtauCorePath>
    <OpenUtauCorePath Condition="'$(OpenUtauCorePath)' == ''">$(MSBuildThisFileDirectory)..\..\lib\OpenUtau.Core.dll</OpenUtauCorePath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.4" />
    <PackageReference Include="Avalonia.Headless" Version="11.2.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.4" />
    <PackageReference Include="Avalonia.Skia" Version="11.2.4" />
    <!-- OpenUtau.Core runtime dependencies touched while building the fake project -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Serilog" Version="4.1.0" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="OpenUtau.Core">
      <HintPath>$(OpenUtauCorePath)</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="OpenUtau.Plugin.ConsonantLength">
      <HintPath>..\..\src\OpenUtau.Plugin.ConsonantLength\bin\Release\OpenUtau.Plugin.ConsonantLength.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="OpenUtau.Plugin.CVVCExpression">
      <HintPath>..\..\src\OpenUtau.Plugin.CVVCExpression\bin\Release\OpenUtau.Plugin.CVVCExpression.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CopyOpenUtauDependencies" AfterTargets="Build">
    <PropertyGroup>
      <OpenUtauCoreDir>$([System.IO.Path]::GetDirectoryName('$(OpenUtauCorePath)'))</OpenUtauCoreDir>
    </PropertyGroup>
    <ItemGroup>
      <ProbeDependency Include="$(OpenUtauCoreDir)\Newtonsoft.Json.dll" Condition="Exists('$(OpenUtauCoreDir)\Newtonsoft.Json.dll')" />
      <ProbeDependency Include="$(OpenUtauCoreDir)\Serilog.dll" Condition="Exists('$(OpenUtauCoreDir)\Serilog.dll')" />
      <ProbeDependency Include="$(OpenUtauCoreDir)\YamlDotNet.dll" Condition="Exists('$(OpenUtauCoreDir)\YamlDotNet.dll')" />
    </ItemGroup>
    <Copy SourceFiles="@(ProbeDependency)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>
</Project>